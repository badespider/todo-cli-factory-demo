{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "software-factory feature map",
  "description": "Shape of factory/feature-map.json (docs/CONTRACTS.md, \"feature-map.sh\"). Rules a schema cannot express (unique ids, dependencies that exist, no cycles, provides keys that are real dependents, status rules, canonical format) are checked by scripts/feature-map.sh validate, which also re-implements every rule here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "features"],
  "properties": {
    "version": { "const": 1 },
    "features": {
      "type": "array",
      "items": { "$ref": "#/definitions/feature" }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^F[0-9]+$"
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "depends_on", "acceptance_criteria", "status", "context", "pr"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/definitions/id" }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": {
          "type": "string",
          "enum": ["todo", "in_progress", "done", "blocked"]
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["business", "design", "code_refs"],
          "properties": {
            "business": { "type": "string" },
            "design": { "type": "string" },
            "code_refs": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "pr": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^https://[!-~]+$" }
          ]
        },
        "provides": {
          "description": "Maps the id of a feature that depends on this one to a one-line note.",
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/id" },
          "additionalProperties": { "type": "string", "pattern": "^[^\\r\\n]*$" }
        },
        "files": {
          "description": "Git glob strings: the expected scope of the change.",
          "type": "array",
          "items": { "type": "string" }
        },
        "blocked_reason": { "type": "string" }
      }
    }
  }
}
